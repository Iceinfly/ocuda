@model OutreachViewModel
@{
    ViewData["Title"] = "Outreach Request";
}
<h1>Outreach Request</h1>
<form asp-action="Outreach" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="LocationId" class="form-label"></label>
            <select asp-for="LocationId" asp-items="Model.Locations" class="form-select"><option value="">Select a branch</option></select>
            <span asp-validation-for="LocationId" class="text-danger"></span>
        </div>
        <div class="col-md-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /><span asp-validation-for="StartDate" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger"></span></div>
    </div>
    <div class="mt-4"><strong>Requested items</strong></div>
    <div class="form-check"><input asp-for="BookBike" class="form-check-input" /><label asp-for="BookBike" class="form-check-label"></label> <span class="text-muted">(14 days notice preferred)</span></div>
    <div class="form-check"><input asp-for="Canopy" class="form-check-input" /><label asp-for="Canopy" class="form-check-label"></label> <span class="text-muted">(7 days notice preferred)</span></div>
    <div class="form-check"><input asp-for="PrizeWheel" class="form-check-input" /><label asp-for="PrizeWheel" class="form-check-label"></label> <span class="text-muted">(7 days notice preferred)</span></div>
    <button class="btn btn-primary mt-4" type="submit">Submit Outreach request</button>
</form>
