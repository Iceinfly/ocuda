@{
    ViewData["Title"] = "Communications Requests";
}

<h1>Communications Requests</h1>
<p class="lead">Submit Communications requests through Ops.</p>

<div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Program &amp; Library PR</h2>
                <p class="card-text">Request flyers, posters, digital images, and display slides for a program.</p>
                <a class="btn btn-primary" asp-action="ProgramPr">Start Program PR request</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">General PR</h2>
                <p class="card-text">Request signage or other general Public Relations materials.</p>
                <a class="btn btn-primary" asp-action="GeneralPr">Start General PR request</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Outreach</h2>
                <p class="card-text">Request the Book Bike, canopy, or prize wheel for an outreach event.</p>
                <a class="btn btn-primary" asp-action="Outreach">Start Outreach request</a>
            </div>
        </div>
    </div>
</div>
