@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Enter a ticket</h1>
        <p class="lead mb-0">Choose the type of request you would like to submit.</p>
    </div>
    <a class="btn btn-primary"
       href="https://mcldaz.happyfox.com/"
       target="_blank"
       rel="noopener noreferrer">
        <span class="fa-solid fa-ticket fa-fw"></span>
        View existing tickets
    </a>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Program &amp; Library PR</h2>
                <p class="card-text">Request flyers, posters, digital images, and display slides for a program.</p>
                <a class="btn btn-primary" asp-action="ProgramPr">Start Program PR request</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">General PR</h2>
                <p class="card-text">Request signage or other general Public Relations materials.</p>
                <a class="btn btn-primary" asp-action="GeneralPr">Start General PR request</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Outreach</h2>
                <p class="card-text">Request the Book Bike, canopy, or prize wheel for an outreach event.</p>
                <a class="btn btn-primary" asp-action="Outreach">Start Outreach request</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Swag</h2>
                <p class="card-text">Request currently available promotional items for an event.</p>
                <a class="btn btn-primary" asp-action="Swag">Start Swag request</a>
            </div>
        </div>
    </div>
</div>
