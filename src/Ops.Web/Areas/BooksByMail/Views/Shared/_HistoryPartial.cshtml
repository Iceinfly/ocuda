@model Ocuda.Ops.Controllers.Areas.BooksByMail.ViewModels.HistoryViewModel

@if (Model.Items.Count == 0)
{
    <div class="alert alert-warning">No recorded checkouts.</div>
}
else
{
    <div>
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th>
                        <a href="#"
                           class="sortable-column"
                           data-orderby="0"
                           data-orderdesc="@(Model.OrderBy == 0 && Model.OrderDesc == false ? "true" : "false")">
                            Title
                            @if (Model.OrderBy == 0)
                            {
                                <span class="fa-solid fa-lg @(Model.OrderDesc ? "fa-sort-down" : "fa-sort-up")"></span>
                            }
                        </a>
                    </th>
                    <th>
                        <a href="#"
                           class="sortable-column"
                           data-orderby="1"
                           data-orderdesc="@(Model.OrderBy == 1 && Model.OrderDesc == false ? "true" : "false")">
                            Author
                            @if (Model.OrderBy == 1)
                            {
                                <span class="fa-solid fa-lg @(Model.OrderDesc ? "fa-sort-down" : "fa-sort-up")"></span>
                            }
                        </a>
                    </th>
                    <th>Category</th>
                    <th>
                        <a href="#"
                           class="sortable-column"
                           data-orderby="2"
                           data-orderdesc="@(Model.OrderBy == 2 && Model.OrderDesc == false ? "true" : "false")">
                            Date
                            @if (Model.OrderBy == 2)
                            {
                                <span class="fa-solid fa-lg @(Model.OrderDesc ? "fa-sort-down" : "fa-sort-up")"></span>
                            }
                        </a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Author</td>
                        <td>@item.Category</td>
                        <td style="white-space: nowrap;">@item.CheckoutDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.MaxPage > 1)
    {
        <nav paginate="@Model" asButtons="true"></nav>
    }
}

<script>
    var historySearchCount = @Model.ItemCount;
</script>